# 部署脚本必须是 LF 换行：CRLF 会让服务器报 bad interpreter: /usr/bin/env bash^M
*.sh text eol=lf
*.bash text eol=lf

# 其余文本统一走 LF，避免跨平台噪音
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
